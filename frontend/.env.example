# Base URL of the Flask backend, without /api.
# The local backend runs on 5001 because macOS AirPlay Receiver owns port 5000.
API_URL=http://127.0.0.1:5001

# Supabase project (one project serves local, staging and production).
# The publishable key is public by design; only the SvelteKit server uses it,
# to keep the session in httpOnly cookies. Never put the secret key here.
SUPABASE_URL=https://xtaralttpdpluhkffryk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ziQkPqpJg3OdkQiIHtJfTQ_tuKv3e0F

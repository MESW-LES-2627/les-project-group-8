{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "les-frontend",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	// Keep this within ~30 days of today.
	"compatibility_date": "2026-10-18",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
	// Public, non-secret config the frontend reads via $env/dynamic/public.
	// Point this at the deployed backend Worker.
	// "vars": {
	// 	"PUBLIC_API_URL": "https://les-api.<your-subdomain>.workers.dev"
	// }
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "les-frontend",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	// Keep this within ~30 days of today.
	"compatibility_date": "2026-10-18",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Environments inherit `main`, `assets` and `compatibility_*`, but NOT
	// `vars` or bindings — set staging-only values under `env.staging`.
	"env": {
		"staging": {
			"name": "les-frontend-staging"
			// "vars": { "PUBLIC_API_URL": "https://<staging-backend>.onrender.com" }
		}
	}
}

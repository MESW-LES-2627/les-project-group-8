{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "les-frontend",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	// Keep this within ~30 days of today.
	"compatibility_date": "2026-10-18",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Read at runtime via `$app/env/private` (declared in src/env.ts).
	// The Supabase publishable key is public by design (never the secret key).
	"vars": {
		"API_URL": "https://les-backend-ocd4.onrender.com",
		"SUPABASE_URL": "https://xtaralttpdpluhkffryk.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ziQkPqpJg3OdkQiIHtJfTQ_tuKv3e0F"
	},
	// Environments inherit `main`, `assets` and `compatibility_*`, but NOT
	// `vars` or bindings — set staging-only values under `env.staging`.
	"env": {
		"staging": {
			"name": "les-frontend-staging",
			"vars": {
				"API_URL": "https://les-backend-staging.onrender.com",
				"SUPABASE_URL": "https://xtaralttpdpluhkffryk.supabase.co",
				"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ziQkPqpJg3OdkQiIHtJfTQ_tuKv3e0F"
			}
		}
	}
}

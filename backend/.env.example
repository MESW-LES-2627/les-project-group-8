# Copy to backend/.env for local development. On Render, set these in each
# service's Environment tab instead.
SUPABASE_URL=https://xtaralttpdpluhkffryk.supabase.co
# The SECRET key (Supabase → Project Settings → API Keys → Secret keys,
# starts with sb_secret_). Never the publishable key: row-level security
# refuses it (ADR 0003). The secret key never leaves the server and never goes
# in git.
SUPABASE_KEY=sb_secret_replace-me
# Optional, for tests/integration only: the PUBLISHABLE key (public by design,
# same value as in frontend/.env.example). The tests use it to check that RLS
# keeps Supabase's REST API shut (ADR 0003). Flask never uses it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ziQkPqpJg3OdkQiIHtJfTQ_tuKv3e0F
